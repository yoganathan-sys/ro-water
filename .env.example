# R-TECH PURE WATER - ENVIRONMENT CONFIGURATION
# Copy this file to .env to configure SMS Gateways

# Owner phone number to receive booking alerts (default: 8056639518)
OWNER_PHONE_NUMBER=8056639518

# OPTION 1: Fast2SMS (Recommended for India - Quick free SMS to 8056639518)
# Sign up free at https://www.fast2sms.com and get your API key:
FAST2SMS_API_KEY=

# OPTION 2: Twilio SMS Gateway (International SMS carrier)
# Sign up at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
